{
  "name": "school-platform",
  "version": "1.0.0",
  "private": true,
  "description": "منصة إدارة مدرسية - Cloudflare Pages + Pages Functions + D1",
  "scripts": {
    "typecheck": "tsc --noEmit -p server/tsconfig.json",
    "build": "npm install --prefix frontend && npm run build --prefix frontend",
    "db:migrate:local": "wrangler d1 migrations apply school_platform_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply school_platform_db --remote",
    "dev": "wrangler pages dev frontend/dist --d1=DB --compatibility-date=2024-11-01"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.23.8",
    "jose": "^5.9.0",
    "bcryptjs": "^2.4.3",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "wrangler": "^3.90.0",
    "typescript": "^5.6.0",
    "@cloudflare/workers-types": "^4.20241004.0",
    "drizzle-orm": "^0.36.0",
    "@types/bcryptjs": "^2.4.6"
  }
}
